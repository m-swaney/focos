# focos secrets. This file stays on this computer and is never committed.
# Shared secret between the dashboard and the local API (generated by focos init).
FOCOS_DASH_TOKEN=

# AI provider key. Only the provider chosen in config/focos.yml needs a value.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# SimpleFIN access URL. The setup wizard fills this after you paste a SimpleFIN setup token.
SIMPLEFIN_ACCESS_URL=

# Optional: self-hosted Sure ledger (advanced; only if config/focos.yml ledger.provider is sure)
SURE_API_URL=http://127.0.0.1:3000
SURE_API_KEY_RW=
SURE_API_KEY_RO=

# Optional: Zillow property values through RapidAPI
RAPIDAPI_KEY=
