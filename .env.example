# Copy to .env (gitignored). This file holds secrets only. The data dir is found through FOCOS_HOME
# (environment variable, `focos --home`, or `focos init --set-default`), never from this file.

# Dashboard <-> local API shared secret (focos init generates one)
FOCOS_DASH_TOKEN=

# AI provider key. Only the provider chosen in config/focos.yml needs a value.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# SimpleFIN access URL (the setup wizard fills this after you paste a setup token)
SIMPLEFIN_ACCESS_URL=

# Optional: self-hosted Sure ledger (only when config/focos.yml ledger.provider is sure)
SURE_API_URL=http://127.0.0.1:3000
SURE_API_KEY_RW=
SURE_API_KEY_RO=

# Optional: Mercury read-only token (cross-check only)
MERCURY_TOKEN=

# Optional: Zillow property values through RapidAPI
RAPIDAPI_KEY=
